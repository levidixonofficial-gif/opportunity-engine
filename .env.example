# ---------------------------------------------------------------------------
# Opportunity Engine — environment variables
# Copy the values you need into .env.local (which is gitignored).
# Non-secret local defaults already live in the committed .env file.
# Every variable is validated at boot by src/lib/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV="development"

# --- Database -------------------------------------------------------------
# Local dev: sqlite. Preview/Production: postgresql (Supabase).
DATABASE_PROVIDER="sqlite"                 # "sqlite" | "postgresql"
DATABASE_URL="file:./prisma/dev.db"
# Supabase (production) example:
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DIRECT_DATABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""               # server-only; used for Storage + RLS-bypass admin ops
NEXT_PUBLIC_SUPABASE_URL=""

# --- Auth: Clerk ---------------------------------------------------------
AUTH_MODE="dev"                            # "dev" | "clerk"
DEV_AUTH_SECRET="change-me"                # HMAC key for the dev-mode session cookie
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""                    # Svix signing secret for /api/webhooks/clerk

# --- Payments: Stripe (Phase 6) ----------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""                        # price_xxx for the Pro plan
STRIPE_PRICE_PREMIUM=""                    # price_xxx for the Premium plan

# --- AI: Anthropic Claude (Phase 4) ----------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL_DEFAULT="claude-sonnet-5"
AI_MODEL_FAST="claude-haiku-4-5-20251001"

# --- Vector search: Pinecone (Phase 4) -------------------------------
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="opportunity-engine"

# --- Redis: Upstash (Phase 7) ---------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email: Resend (Phase 7) --------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Opportunity Engine <hello@yourdomain.com>"

# --- Analytics: PostHog (Phase 7) --------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Error monitoring: Sentry (Phase 7) -------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""                       # build-time only, for source map upload

# --- App ---------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
