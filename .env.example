# ---------------------------------------------------------------------------
# Opportunity Engine — environment variables
#
# Local dev: the committed `.env` already has working defaults; you only need
# `.env.local` for real keys. See docs/environment.md for the full reference,
# including which vars are REQUIRED in production and which are optional.
#
# Every variable below is validated at boot by src/lib/env.ts. In production the
# app REFUSES to start with the insecure dev defaults (AUTH_MODE=dev, the default
# DEV_AUTH_SECRET, non-postgres provider, or a localhost APP_URL).
# ---------------------------------------------------------------------------

NODE_ENV="development"                       # development | test | production

# --- Database (REQUIRED) — PostgreSQL everywhere ------------------------
# Local dev: run `npm run pg:up` (embedded PGlite Postgres, no Docker), then
# `npm run db:deploy && npm run db:seed`. The committed .env already points here.
DATABASE_PROVIDER="postgresql"               # must be "postgresql"
DATABASE_URL="postgresql://postgres@127.0.0.1:55432/postgres?sslmode=disable"
# Production (Supabase): pooled URL in DATABASE_URL, direct URL in DIRECT_DATABASE_URL.
#   DATABASE_URL="postgresql://…pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_DATABASE_URL="postgresql://…pooler.supabase.com:5432/postgres"
DIRECT_DATABASE_URL=""                       # non-pooled URL — used by `prisma migrate deploy`
SUPABASE_SERVICE_ROLE_KEY=""                 # reserved — Supabase Storage / RLS admin (unused today)

# --- Auth: Clerk -------------------------------------------------------
AUTH_MODE="dev"                              # dev (signed-cookie shim) | clerk. MUST be "clerk" in production.
DEV_AUTH_SECRET="change-me-to-something-random"   # HMAC key for the dev session cookie. MUST NOT be the default in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""         # required when AUTH_MODE=clerk
CLERK_SECRET_KEY=""                          # required when AUTH_MODE=clerk
CLERK_WEBHOOK_SECRET=""                      # Svix signing secret for /api/webhooks/clerk

# --- Payments: Stripe (optional) -------------------------------------
STRIPE_SECRET_KEY=""                         # sk_live_… / sk_test_… — enables checkout + webhook
STRIPE_WEBHOOK_SECRET=""                     # whsec_… for /api/webhooks/stripe
STRIPE_PRICE_PRO=""                          # price_… for the Pro plan
STRIPE_PRICE_PREMIUM=""                      # price_… for the Premium plan

# --- AI: Anthropic Claude (optional) --------------------------------
ANTHROPIC_API_KEY=""                         # enables the assistant + AI generator path
AI_MODEL_DEFAULT="claude-sonnet-5"           # used for Premium ("advanced_ai") plans
AI_MODEL_FAST="claude-haiku-4-5-20251001"    # used for Free / Pro plans

# --- Vector search: Pinecone (optional) -----------------------------
PINECONE_API_KEY=""                          # without both, natural-language search falls back to keyword scoring
PINECONE_INDEX_NAME="opportunity-engine"

# --- Redis: Upstash (optional) -------------------------------------
UPSTASH_REDIS_REST_URL=""                    # without both, rate limiting uses an in-process limiter (single instance)
UPSTASH_REDIS_REST_TOKEN=""

# --- Email: Resend (optional) ------------------------------------
RESEND_API_KEY=""                            # without both, transactional email is logged to the server console
RESEND_FROM_EMAIL="Opportunity Engine <hello@yourdomain.com>"

# --- Analytics: PostHog (optional, consent-gated) --------------
NEXT_PUBLIC_POSTHOG_KEY=""                   # client analytics init only after the visitor accepts analytics cookies
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Error monitoring: Sentry (optional) ----------------------
SENTRY_DSN=""                                # server — enables captureException + instrumentation.ts
NEXT_PUBLIC_SENTRY_DSN=""                    # client boundary reporting
SENTRY_AUTH_TOKEN=""                         # BUILD-TIME ONLY — source-map upload in CI (not read at runtime)

# --- App (REQUIRED) --------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # MUST be your real https origin in production
