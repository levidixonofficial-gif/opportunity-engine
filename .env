# Committed safe development defaults. NO SECRETS HERE.
# Real keys go in .env.local (gitignored). See .env.example for the full list.

NODE_ENV="development"

# --- Database: local dev runs PostgreSQL via PGlite (embedded, no Docker) ---
# Start it in another terminal:  npm run pg:up
# First-time setup:              npm run db:deploy && npm run db:seed
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://postgres@127.0.0.1:55432/postgres?sslmode=disable"

# --- Auth: "dev" = local signed-cookie shim; "clerk" = real Clerk ---
AUTH_MODE="dev"
DEV_AUTH_SECRET="dev-only-insecure-secret-change-me"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
